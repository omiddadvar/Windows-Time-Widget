<Window x:Class="WindowsTimeWidget.Views.Windows.MainWindow"
        xmlns:uc="clr-namespace:WindowsTimeWidget.Views.UserControls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsTimeWidget.Views.Windows"
        mc:Ignorable="d"
        Title="DateTime Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Width="{Binding WidgetWidth}"
        Height="{Binding WidgetHeight}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged">
    <Border CornerRadius="14"
            Background="{Binding BackgroundBrush}"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="12">

        <Grid>
            <!-- Close button (hover) -->
            <Button x:Name="CloseButton"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Width="20" Height="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-6,-6,0"
                    Opacity="0"
                    ToolTip="Close"
                    Click="CloseButton_Click">
                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="White"/>
            </Button>

            <uc:DateTimeDisplay VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
        </Grid>
    </Border>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <DropShadowEffect x:Key="TextShadowEffect"
                          BlurRadius="6"
                          ShadowDepth="0"
                          Opacity="0.8"
                          Color="Black"/>
    </Window.Resources>
</Window>
