<Window x:Class="WindowsTimeWidget.Views.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsTimeWidget.Views.Windows"
        mc:Ignorable="d"
        Title="Widget Settings"
        Width="460" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStyle="None">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Window Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" FlowDirection="RightToLeft"  Margin="0,-10,0,16">
            <Button Background="Transparent" BorderThickness="0" Command="{Binding CloseCommand}">
                <materialDesign:PackIcon Kind="Close" 
                                        Width="30" Height="30"
                                        VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
        
        <!-- Header -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,25">
            <materialDesign:PackIcon Kind="Cog" Width="24" Height="24"
                                     VerticalAlignment="Center"/>
            <TextBlock Text="Widget Settings" FontSize="22" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Time Zone -->
                <TextBlock Text="Time Zone" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding TimeZones}"
                          SelectedItem="{Binding SelectedTimeZone}"
                          DisplayMemberPath="FullDisplay"
                          materialDesign:HintAssist.Hint="Select time zone"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,16"/>

                <!-- Widget Size -->
                <TextBlock Text="Widget Size" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <UniformGrid Rows="1" Columns="3" Margin="0,0,0,16">
                    <RadioButton Content="Small" GroupName="Size"
                                 IsChecked="{Binding SelectedSize, Converter={StaticResource EnumToBool}, ConverterParameter=Small}"
                                 Style="{StaticResource MaterialDesignRadioButton}"
                                 HorizontalAlignment="Center"/>
                    <RadioButton Content="Medium" GroupName="Size"
                                 IsChecked="{Binding SelectedSize, Converter={StaticResource EnumToBool}, ConverterParameter=Medium}"
                                 Style="{StaticResource MaterialDesignRadioButton}"
                                 HorizontalAlignment="Center"/>
                    <RadioButton Content="Large" GroupName="Size"
                                 IsChecked="{Binding SelectedSize, Converter={StaticResource EnumToBool}, ConverterParameter=Large}"
                                 Style="{StaticResource MaterialDesignRadioButton}"
                                 HorizontalAlignment="Center"/>
                </UniformGrid>

                    <!-- Language -->
                    <TextBlock Text="Language" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="English"
                     GroupName="Lang"
                     IsChecked="{Binding SelectedLanguage,
                                          Converter={StaticResource EnumToBool},
                                          ConverterParameter=English}"
                     Style="{StaticResource MaterialDesignRadioButton}"
                     Margin="0,0,20,0"/>
                    <RadioButton Content="Persian"
                         GroupName="Lang"
                         IsChecked="{Binding SelectedLanguage,
                                              Converter={StaticResource EnumToBool},
                                              ConverterParameter=Persian}"
                         Style="{StaticResource MaterialDesignRadioButton}"/>
                </StackPanel>

                <!-- Show both dates -->
                <CheckBox Content="Show both Gregorian and Persian dates"
                    IsChecked="{Binding ShowBothDates}"
                    Style="{StaticResource MaterialDesignCheckBox}"
                    Margin="0,0,0,16"/>

                <!-- Color -->
                <TextBlock Text="Widget Color" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hex input (still editable for precision) -->
                    <TextBox Grid.Column="0"
                         Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Hex (#AARRGGBB)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <!-- Swatch button → opens popup with ColorPicker -->
                <ToggleButton x:Name="ColorPickerToggle"
                  Grid.Column="1"
                  Width="44" Height="44"
                  Margin="10,0,0,0"
                  Padding="0"
                  BorderThickness="1"
                  BorderBrush="#55000000"
                  Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                  ToolTip="Pick a color">
                        <materialDesign:PackIcon Kind="EyedropperVariant"
                                 Width="18" Height="18"
                                 Foreground="White"/>
                    </ToggleButton>

                    <!-- Popup with the actual picker -->
                    <Popup Grid.Column="1"
                       IsOpen="{Binding IsChecked, ElementName=ColorPickerToggle, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=ColorPickerToggle}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                        <materialDesign:Card Margin="0,6,0,0"
                             UniformCornerRadius="8"
                             materialDesign:ElevationAssist.Elevation="Dp4">
                            <materialDesign:ColorPicker Width="300"
                                        Height="380"
                                        Color="{Binding ColorHex,
                                                         Converter={StaticResource ColorToHex},
                                                         Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged}"/>
                        </materialDesign:Card>
                    </Popup>
                </Grid>

                <!-- Opacity -->
                <TextBlock Text="Opacity" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Minimum="0.3" Maximum="1.0"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Opacity}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Opacity, StringFormat={}{0:P0}}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>

                <!-- Format -->
                <TextBlock Text="Format" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox Content="24-hour format"
                          IsChecked="{Binding Use24Hour}"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Margin="0,0,0,4"/>
                <CheckBox Content="Show seconds"
                          IsChecked="{Binding ShowSeconds}"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Margin="0,0,0,4"/>
                <CheckBox Content="Show date"
                          IsChecked="{Binding ShowDate}"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Margin="0,0,0,16"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button Content="Reset"
                    Command="{Binding ResetCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
